generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// LOKASYON
// ─────────────────────────────────────────────

model City {
  id            Int                  @id @default(autoincrement())
  // TEKİL: ensureGeo her açılışta "önce oku sonra yaz" ile çalışıyor. Sıfır-kesinti deploy'da
  // eski ve yeni konteyner ~20 sn BİRLİKTE çalıştığı için (overlapSeconds) ikisi de aynı anda
  // "İstanbul yok" görüp iki kez ekleyebilir. Tekillik bunu DB seviyesinde imkânsız kılar.
  name          String               @unique
  neighborhoods Neighborhood[]
  venues        Venue[]
  users         User[]
  leaderboards  MonthlyLeaderboard[]
  createdAt     DateTime             @default(now())
}

model Neighborhood {
  id           Int                  @id @default(autoincrement())
  name         String
  latitude     Float
  longitude    Float
  city         City                 @relation(fields: [cityId], references: [id])
  cityId       Int
  users        User[]
  venues       Venue[]
  leaderboards MonthlyLeaderboard[]

  // Aynı ildeki mahalle adı TEKİL — bkz. City.name yorumu (ensureGeo yarışı).
  @@unique([cityId, name])
}

// ─────────────────────────────────────────────
// SPOR KATEGORİLERİ
// ─────────────────────────────────────────────

model SportCategory {
  id            Int                  @id @default(autoincrement())
  name          String
  iconUrl       String?
  colorHex      String?
  hasInstructor Boolean              @default(true)
  // ONLINE'A UYGUN MU — kural TEK KAYNAKTA. İstemcilere sabit liste gömmek iki kopya demekti ve
  // bu repoda o sınıf hatanın bedeli ödendi (istemcide sabit tier listesi). Sunucu ders açarken
  // reddediyor, web ve mobil kategori filtresini bu alandan çiziyor.
  // Karar (19 Ağu 2026): Yoga · Pilates · Fitness · Dans AÇIK. Dövüş Sporları KAPALI — online'da
  // yalnız kardiyo türevi verilebilir ve o zaten Fitness'ın içinde; adın vaat ettiği teknik/
  // partner çalışması karşılanamıyor. Yüzme/Binicilik/Deniz Sporları/Tenis fiziksel olarak imkânsız.
  onlineAllowed Boolean              @default(false)
  classes       Class[]
  dropInSlots   DropInSlot[]
  venueSports   VenueSportCategory[]
  activityLogs  ActivityLog[]
  leaderboards  MonthlyLeaderboard[]
  userBadges    UserBadge[]
  tierHistories UserTierHistory[]
}

// ─────────────────────────────────────────────
// TİER SİSTEMİ
// ─────────────────────────────────────────────

model Tier {
  id            Int               @id @default(autoincrement())
  name          String
  minLessons    Int
  pointRate     Int               @default(0)
  iconUrl       String?
  colorHex      String?
  users         User[]
  tierHistories UserTierHistory[]
  activityLogs  ActivityLog[]
}

model UserTierHistory {
  id              Int           @id @default(autoincrement())
  user            User          @relation(fields: [userId], references: [id])
  userId          Int
  tier            Tier          @relation(fields: [tierId], references: [id])
  tierId          Int
  sportCategory   SportCategory @relation(fields: [sportCategoryId], references: [id])
  sportCategoryId Int
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
}

// ─────────────────────────────────────────────
// ROZETLER
// ─────────────────────────────────────────────

model Badge {
  id            Int           @id @default(autoincrement())
  key           String?       @unique
  name          String
  description   String
  iconUrl       String?
  criteriaType  String
  criteriaValue Int?
  userBadges    UserBadge[]
  activityLogs  ActivityLog[]
}

model UserBadge {
  id              Int            @id @default(autoincrement())
  user            User           @relation(fields: [userId], references: [id])
  userId          Int
  badge           Badge          @relation(fields: [badgeId], references: [id])
  badgeId         Int
  sportCategory   SportCategory? @relation(fields: [sportCategoryId], references: [id])
  sportCategoryId Int?
  venue           Venue?         @relation(fields: [venueId], references: [id])
  venueId         Int?
  // Sezon şampiyonu rozetleri için (season_champion): kapsam + derece + sezon
  rank            Int? // 1=altın, 2=gümüş, 3=bronz
  seasonKey       String? // örn "yaz-2026" — sezon başına tek kez ödül (çift-vermez)
  scopeType       String? // 'city' | 'district'
  scopeId         Int? // scopeType'a göre cityId veya neighborhoodId
  earnedAt        DateTime       @default(now())
}

// ─────────────────────────────────────────────
// KULLANICI
// ─────────────────────────────────────────────

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  // 6 HANELİ DOĞRULAMA KODU (SHA-256). Kayıt akışı artık e-postadaki linke değil, kullanıcının
  // yazdığı koda dayanıyor: mobilde link tıklamak uygulamadan çıkıp geri dönmeyi gerektiriyor,
  // kod ise ekranı hiç terk etmeden girilebiliyor. `token` alanı eski link akışı ve satır
  // tekilliği için duruyor.
  // NOT: 6 hanelik bir kodun hash'i, sızan bir yedeğe karşı gerçek koruma DEĞİLDİR (uzay çok
  // küçük). Asıl koruma KISA ÖMÜR (15 dk) ve DENEME SINIRI (attempts). Hash yine de duruyor ki
  // canlı kod, günlüklere/yedeklere düz metin düşmesin.
  code      String?
  // Yanlış deneme sayacı: 6 hane = 1.000.000 olasılık; sınırsız deneme kaba kuvvete açıktır.
  attempts  Int      @default(0)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, used])
}

model User {
  id                     Int           @id @default(autoincrement())
  username               String        @unique
  email                  String        @unique
  phone                  String?
  passwordHash           String
  fullName               String
  isEmailVerified        Boolean       @default(false)
  // Parola değişimi damgası. Refresh jetonları iptal ediliyor ama ZATEN DAĞITILMIŞ access
  // token'lar (1 saat) JWT olduğu için iptal edilemiyordu: parola değiştikten sonra çalınmış
  // bir jeton bir saat daha tam yetkiyle çalışıyordu. Salon/eğitmen realm'lerinde bu kapı
  // vardı, kullanıcı realm'inde yoktu. (Bkz. middlewares/auth.ts)
  passwordChangedAt      DateTime?
  avatarUrl              String?
  bio                    String?
  neighborhood           Neighborhood? @relation(fields: [neighborhoodId], references: [id])
  neighborhoodId         Int?
  city                   City?         @relation(fields: [cityId], references: [id])
  cityId                 Int?
  latitude               Float?
  longitude              Float?
  profilePrivacy         String        @default("public")
  activityPrivacy        String        @default("public")
  emailReminders         Boolean       @default(true)
  smsReminders           Boolean       @default(false)
  // Bildirim dili: e-posta/push metinleri bu dille üretilir (in-app bildirimler anahtar+parametre
  // saklandığı için istemcide çevrilir). İstemci dil değiştirince PUT /api/auth/locale ile günceller.
  locale                 String        @default("tr")
  pushToken              String?
  tier                   Tier?         @relation(fields: [tierId], references: [id])
  tierId                 Int?
  totalLessonsCompleted  Int           @default(0)
  rewardPoints           Int           @default(0)
  rewardPointsYear       Int? // puanların ait olduğu yıl (yıllık reset için)
  recordStreak           Int           @default(0) // kullanıcının EN UZUN (rekor) günlük serisi — profilde tek rozet, yeni rekorda güncellenir
  lastStreakNudgeAt      DateTime? // son streak teşvik e-postası (spam önleme)
  preferredSports        Json          @default("[]") // kayıtta seçilen spor tercihleri (isim dizisi)
  preferredNeighborhoods Json          @default("[]") // kayıtta seçilen mahalle tercihleri (id dizisi)
  referralCode           String?       @unique
  creditBalance          Int           @default(0)
  referralCount          Int           @default(0)
  banned                 Boolean       @default(false)
  createdAt              DateTime      @default(now())

  venuesOwned             Venue[]
  instructorProfile       Instructor?
  bookings                Booking[]
  reviews                 Review[]
  tierHistories           UserTierHistory[]
  badges                  UserBadge[]
  activityLogs            ActivityLog[]
  following               Follow[]                 @relation("Follower")
  followers               Follow[]                 @relation("Following")
  rewardPointLogs         RewardPoint[]
  rewardRedemptions       RewardRedemption[]
  leaderboards            MonthlyLeaderboard[]
  dropInParticipants      DropInParticipant[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  waitlistEntries         Waitlist[]
  favoriteVenues          FavoriteVenue[]
  referralsSent           Referral[]               @relation("ReferralSender")
  referralsReceived       Referral[]               @relation("ReferralReceiver")
  chatMessages            ChatMessage[]
  notifications           Notification[]           @relation("NotificationRecipient")
  activityLikes           ActivityLike[]
  activityComments        ActivityComment[]
  reportsMade             Report[]                 @relation("ReportsMade")
  reportsAgainst          Report[]                 @relation("ReportsAgainst")
  refreshTokens           RefreshToken[]

  // registerPushToken ayni token'i baska hesaptan koparirken updateMany yapiyor -> indekssiz tam tablo taramasi
  @@index([pushToken])
}

// ─────────────────────────────────────────────
// ŞİKAYET (uygunsuz profil/içerik bildirimi)
// ─────────────────────────────────────────────

model Report {
  id             Int       @id @default(autoincrement())
  // reporterUserId NULLABLE + ON DELETE SET NULL. Eskiden NOT NULL'di ve hesap silmede o kisinin
  // ACTIGI sikayetler de siliniyordu — yani BASKA kullanicilar hakkindaki incelenmemis moderasyon
  // kaniti kayboluyordu. Olculdu: 10 acik sikayet -> sikayet eden hesabini sildi -> 0.
  // Istismar yolu acikti: taciz eden, kurbani hesabini silmeye ikna ederse kayit da yok oluyordu.
  // Sikayet ASIL olarak SIKAYET EDILEN hakkindadir; sikayet eden kimligi ek bilgidir.
  reporter       User?     @relation("ReportsMade", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reporterUserId Int?
  reportedUser   User      @relation("ReportsAgainst", fields: [reportedUserId], references: [id])
  reportedUserId Int
  reason         String?
  status         String    @default("open") // open | resolved | dismissed
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([status])
  @@index([reportedUserId])
}

// İletişim / şikayet formu mesajları (public form; auth yok, userId yok).
// E-posta bildirimine EK olarak kalıcı kayıt — e-posta gitmese bile şikayet kaybolmaz.
model Complaint {
  id         Int       @id @default(autoincrement())
  name       String
  email      String
  subject    String
  message    String
  status     String    @default("open") // open | resolved
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
}

// ─────────────────────────────────────────────
// VENUE & HOCA
// ─────────────────────────────────────────────

model Venue {
  id                   Int                 @id @default(autoincrement())
  name                 String
  description          String?
  owner                User?               @relation(fields: [ownerUserId], references: [id])
  ownerUserId          Int?
  address              String
  neighborhood         Neighborhood?       @relation(fields: [neighborhoodId], references: [id])
  neighborhoodId       Int?
  city                 City?               @relation(fields: [cityId], references: [id])
  cityId               Int?
  latitude             Float?
  longitude            Float?
  phone                String?
  email                String?             @unique
  passwordHash         String?
  // Parola en son ne zaman değişti. Salon/eğitmen token'ları 7 gün geçerli ve refresh-token
  // tablosu YOK → parola değişince eski JWT'leri iptal edecek başka bir kanca yoktu: ele
  // geçirilmiş oturum, parola sıfırlansa bile 7 gün tam yetkiyle çalışmaya devam ediyordu.
  // venueAuthMiddleware token'ın iat'ini bu değerle karşılaştırıp eskileri reddeder.
  passwordChangedAt    DateTime?
  panelRefreshTokens   PanelRefreshToken[]
  website              String?
  coverImageUrl        String?
  images               Json                @default("[]")
  pendingCoverImageUrl String? // admin onayı bekleyen kapak
  pendingImages        Json                @default("[]") // admin onayı bekleyen galeri
  imagesPendingReview  Boolean             @default(false) // onay bekleyen resim var mı
  isActive             Boolean             @default(true)
  isVerified           Boolean             @default(false)
  isApproved           Boolean             @default(false)
  // ÖNCÜ SALON SIRASI (O13) — salon ONAYLANDIĞI anda verilir, kayıt anında DEĞİL.
  // Kayıt tarihine bağlasaydık, kaydolup hiç onaylanmayan bir salon sırayı kilitlerdi.
  // İlk 50 rozet alır; öne çıkarma platform 200 onaylı salona ulaşana dek sürer (utils/founder.ts).
  // @unique: sıra numarası ÇİFTLENEMEZ. Eşzamanlı iki onayda "MAX+1" okuması yarışır ve aynı
  // numarayı üretebilir — bu repoda "kodla sağlanan tekillik eşzamanlılıkta işe yaramaz" dersi
  // zaten ödendi, tekillik DB'de.
  founderRank          Int?                @unique
  isSuspended          Boolean             @default(false)
  avgRating            Float               @default(0)
  totalReviews         Int                 @default(0)
  createdAt            DateTime            @default(now())

  // İyzico Pazaryeri alt-üye (sub-merchant) alanları
  subMerchantType        String? // PERSONAL | PRIVATE_COMPANY | LIMITED_OR_JOINT_STOCK_COMPANY
  legalCompanyTitle      String? // ünvan (şirket)
  iban                   String?
  taxOffice              String?
  taxNumber              String?
  identityNumber         String? // TCKN
  contactName            String? // şahıs ad
  contactSurname         String? // şahıs soyad
  payoutGsm              String? // +90...
  iyzicoSubMerchantKey   String? // iyzico'dan dönen anahtar — ödeme anında şart
  subMerchantStatus      String    @default("none") // none|submitted|approved|rejected
  kycDocs                Json      @default("{}") // {vergiLevhasi,imzaSirkuleri,faaliyetBelgesi,ticaretSicilGazetesi,kimlik}
  ibanMatchConsent       Boolean   @default(false)
  subMerchantSubmittedAt DateTime?
  subMerchantApprovedAt  DateTime?
  subMerchantRejection   String?

  sportCategories     VenueSportCategory[]
  instructors         Instructor[]
  classes             Class[]
  dropInSlots         DropInSlot[]
  reviews             Review[]
  userBadges          UserBadge[]
  payouts             VenuePayout[]
  favoritedBy         FavoriteVenue[]
  coupons             Coupon[]
  passwordResetTokens VenuePasswordResetToken[]
}

model VenueSportCategory {
  id              Int           @id @default(autoincrement())
  venue           Venue         @relation(fields: [venueId], references: [id])
  venueId         Int
  sportCategory   SportCategory @relation(fields: [sportCategoryId], references: [id])
  sportCategoryId Int
}

model Instructor {
  id                 Int                 @id @default(autoincrement())
  user               User?               @relation(fields: [userId], references: [id])
  userId             Int?                @unique
  // MEKÂNSIZ (bireysel) HOCA — venueId NULLABLE. Bugüne kadar her eğitmen bir salona aitti ve
  // salon tarafından davet ediliyordu; venueId=null olan eğitmen KENDİ kaydolur, kendi adına
  // online ders satar. Bkz. Class.venueId ve src/utils/seller.ts.
  venue              Venue?              @relation(fields: [venueId], references: [id], onDelete: Restrict)
  venueId            Int?
  fullName           String
  specialty          String?
  specialtyEn        String?
  bio                String?
  bioEn              String?
  avatarUrl          String?
  phone              String? // salon kaydında girilebilir (createInstructor bunu yazıyordu — kolon eklendi)
  // email tekilliği @unique yerine UYGULAMA düzeyinde (invite/create'te kontrol) → prod db push
  // veri-kaybı uyarısına takılmaz (salon-kontrollü, düşük hacimli oluşturma). Login findFirst kullanır.
  email              String? // eğitmen girişi + davet e-postası
  passwordHash       String? // eğitmen kendi şifresini belirleyince (davet/reset) dolar
  passwordChangedAt  DateTime? // bkz. Venue.passwordChangedAt — eski JWT'leri iptal eder
  panelRefreshTokens PanelRefreshToken[]
  inviteStatus       String              @default("none") // none | pending (davet gönderildi) | active (giriş kurdu)
  avgRating          Float               @default(0)
  totalReviews       Int                 @default(0)
  isActive           Boolean             @default(true)
  verified           Boolean             @default(false) // admin onaylı "doğrulanmış hoca" tiki (KALİTE işareti)
  // SATIŞ KAPISI — `verified` ile KARIŞTIRMA. `verified` mavi tiktir, görünürlüğü etkilemez;
  // `isApproved` mekânsız (venueId=null) eğitmenin dersinin yayına çıkıp çıkmadığını belirler ve
  // salonun `isApproved`'ının birebir karşılığıdır. Salona bağlı eğitmende bu alan OKUNMAZ —
  // orada kapı salonun durumudur (bkz. src/utils/seller.ts).
  isApproved         Boolean             @default(false)
  approvedAt         DateTime?
  rejectionReason    String?
  // Kendi kaydolan eğitmenin başvuruyu tamamladığı an. venueId=null && submittedAt=null olan
  // kayıt "yarım başvuru"dur, admin listesinde beklemez.
  submittedAt        DateTime?
  createdAt          DateTime            @default(now())

  classes             Class[]
  reviews             Review[]
  passwordResetTokens InstructorPasswordResetToken[]

  @@index([venueId])
}

// Eğitmen davet/şifre-sıfırlama token'ı (VenuePasswordResetToken'ın aynası; tek-kullanım + 1sa expiry)
model InstructorPasswordResetToken {
  id           Int        @id @default(autoincrement())
  instructorId Int
  token        String     @unique
  expiresAt    DateTime
  used         Boolean    @default(false)
  createdAt    DateTime   @default(now())
  instructor   Instructor @relation(fields: [instructorId], references: [id])

  @@index([instructorId])
}

// ─────────────────────────────────────────────
// DERS & SEANS
// ─────────────────────────────────────────────

model Class {
  id              Int            @id @default(autoincrement())
  // MEKÂNSIZ (bireysel) HOCA — venueId artık NULLABLE.
  // Salona bağlı derste satıcı SALONDUR ve görünürlük kapısı salonun durumudur; mekânsız hoca
  // dersinde satıcı EĞİTMENDİR ve kapı eğitmenin kendi onayıdır. Bu iki kaynağı her çağrı
  // yerinde ayrı ayrı yorumlamak, denetimlerin "KALIP B — tek örneği düzelt, sınıfı kapatma"
  // hatasının davetiyesidir → TEK yardımcıdan geç: src/utils/seller.ts.
  venue           Venue?         @relation(fields: [venueId], references: [id], onDelete: Restrict)
  venueId         Int?
  instructor      Instructor?    @relation(fields: [instructorId], references: [id])
  instructorId    Int?
  sportCategory   SportCategory? @relation(fields: [sportCategoryId], references: [id])
  sportCategoryId Int?
  title           String
  titleEn         String?
  description     String?
  category        String?
  duration        Int?
  durationMinutes Int
  basePrice       Float
  capacity        Int
  classType       String         @default("regular")
  // TESLİM BİÇİMİ: 'in_person' | 'online'. Online = programlı CANLI ders; kayıtlı video değil
  // (ürün kararı). Mekânsız hoca (venueId=null) yalnız 'online' ders açabilir — adresi yok.
  deliveryMode    String         @default("in_person")
  // Online dersin canlı bağlantısı. HASSAS ALAN: rezervasyonu olmayan biri görürse derse
  // bedavaya girer. Public yanıtlardan strip edilir; yalnız rezervasyon sahibine ve dersin
  // sahibine (salon/eğitmen) döner. Bkz. utils/sanitize.ts.
  meetingUrl      String?
  recurrence      Json?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  sessions Class_Session[]

  @@index([venueId])
  @@index([instructorId])
}

model Class_Session {
  id              Int      @id @default(autoincrement())
  class           Class    @relation(fields: [classId], references: [id])
  classId         Int
  startsAt        DateTime
  endsAt          DateTime
  // Seansın TOPLAM kapasitesi — rezervasyonla AZALMAZ. Kalan yer her zaman
  // utils/occupancy.ts ile hesaplanır. DB kolon adı geçmişten "availableSpots"
  // kaldığı için @map ile eşleniyor: isim yalan söylüyordu ("kalan yer" sanılıp
  // üç istemcide de öyle gösteriliyordu), kolonu taşımadan alan adı düzeltildi.
  capacity        Int      @map("availableSpots")
  // ONLINE SEANS BAĞLANTISI — Class.meetingUrl'i EZER. İki seviye gerekiyor çünkü tekrarlayan
  // Zoom/Meet toplantısı tek link üretir (ders seviyesi yeter) ama tek seferlik toplantı her
  // seans için ayrı link üretir. Boşsa dersin linkine düşülür. HASSAS: yalnız rezervasyon
  // sahibine ve dersin sahibine döner.
  meetingUrl      String?
  status          String   @default("open")
  cancelledReason String?
  createdAt       DateTime @default(now())

  bookings Booking[]
  waitlist Waitlist[]

  // (classId, startsAt) TEKİL — index'i ensureIndexes ham SQL ile yaratıyordu ama şemada
  // TANIMLI DEĞİLDİ. Bu bir SÜRÜKLENMEDİR: Prisma index'i "fazlalık" görür; `db push`
  // döneminde onu düşürebilir, migration döneminde ise `migrate dev` her seferinde
  // "veritabanını sıfırlamam lazım" der. map: mevcut index ADIYLA eşleşir → prod'da yeni
  // index yaratılmaz, sadece Prisma'ya "bu zaten var" denmiş olur.
  @@unique([classId, startsAt], map: "class_session_class_startsat_unique")
  @@index([classId])
  @@index([startsAt])
}

// ─────────────────────────────────────────────
// DROP-IN MAÇ
// ─────────────────────────────────────────────

model DropInSlot {
  id              Int           @id @default(autoincrement())
  venue           Venue         @relation(fields: [venueId], references: [id])
  venueId         Int
  sportCategory   SportCategory @relation(fields: [sportCategoryId], references: [id])
  sportCategoryId Int
  title           String
  startsAt        DateTime
  endsAt          DateTime
  format          String
  totalPlayers    Int
  currentPlayers  Int           @default(0)
  totalPrice      Float
  pricePerPerson  Float
  status          String        @default("open")
  visibility      String        @default("open")
  privateCode     String?
  bookedBy        Int?
  createdAt       DateTime      @default(now())

  participants DropInParticipant[]
  bookings     Booking[]

  // public drop-in listesi (status+visibility+startsAt) ve salon paneli (venueId) -- model hic indekssizdi
  @@index([venueId])
  @@index([status, visibility, startsAt])
}

model DropInParticipant {
  id           Int        @id @default(autoincrement())
  slot         DropInSlot @relation(fields: [slotId], references: [id])
  slotId       Int
  user         User       @relation(fields: [userId], references: [id])
  userId       Int
  team         String?
  payment      Payment?   @relation(fields: [paymentId], references: [id])
  paymentId    Int?
  checkInCode  String?    @unique
  checkedIn    Boolean    @default(false)
  checkedInAt  DateTime?
  joinedAt     DateTime   @default(now())
  status       String     @default("confirmed")
  /// İptal sonucu — Booking.refundType/refundAmount ile AYNI anlamda.
  /// Katılımcı satırı silinmiyor, damgalanıyor: silinseydi iade borcunu gösteren hiçbir kayıt
  /// kalmazdı (aynı hata ders iptalinde de vardı, O12'de düzeltildi).
  refundType   String?
  refundAmount Float?
  cancelledAt  DateTime?

  @@index([slotId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// BOOKING & ÖDEME
// ─────────────────────────────────────────────

model Booking {
  id               Int            @id @default(autoincrement())
  user             User           @relation(fields: [userId], references: [id])
  userId           Int
  session          Class_Session? @relation(fields: [sessionId], references: [id])
  sessionId        Int?
  dropInSlot       DropInSlot?    @relation(fields: [dropInSlotId], references: [id])
  dropInSlotId     Int?
  bookingType      String
  status           String         @default("pending")
  baseAmount       Float
  discountAmount   Float          @default(0)
  commissionAmount Float
  userCommission   Float          @default(0)
  venueCommission  Float
  finalAmount      Float
  venuePayout      Float
  bookingNumber    String         @unique
  groupSize        Int            @default(1)
  taggedFriends    Json           @default("[]")
  reminderSent     Boolean        @default(false)
  ratingPromptSent Boolean        @default(false) // ders bitiminden 2sa sonra "puanla" hatırlatması gönderildi mi
  checkInCode      String?        @unique
  checkedIn        Boolean        @default(false)
  checkedInAt      DateTime?
  // SALON DERSİ ERTELEDİ: seansın saati salon tarafından değiştirildiğinde damgalanır.
  // Yeni saat kullanıcının tercihi DEĞİLDİR → iptal penceresi kuralı (12 saat kala iptal yok,
  // 12-24 saat yarım iade) bu rezervasyonda uygulanmaz; kullanıcı ders başlayana kadar
  // TAM İADE ile iptal edebilir. Kullanıcı kendi isteğiyle transfer ederse damga silinir
  // (yeni seansı kendi seçmiş olur).
  rescheduledAt    DateTime?
  // İPTAL SONUCU — YAPISAL (O14 hazırlığı). Bu bilgi bugüne kadar YALNIZCA `notes` alanında
  // Türkçe metin olarak duruyordu ("İptal: Yarım iade (₺500)") ve web iki yerde
  // `notes.split('İptal: ')[1]` ile ayrıştırıyordu — önek değişse arayüz sessizce boşalırdı.
  //
  // Komisyon motoru (#79) geldiğinde geç iptalde komisyon TUTULAN TUTAR üzerinden hesaplanacak
  // (kullanıcı kararı 24 Ağu 2026). O taban serbest metinden okunamaz; burada duruyor.
  // tutulan = finalAmount - refundAmount.
  refundType       String? // 'full' | 'half' | 'none'
  refundAmount     Float?
  coupon           Coupon?        @relation(fields: [couponId], references: [id])
  couponId         Int?
  creditUsed       Int            @default(0)
  pointsEarned     Int            @default(0)
  notes            String?
  createdAt        DateTime       @default(now())
  confirmedAt      DateTime?
  cancelledAt      DateTime?

  payment           Payment?
  commissionHistory CommissionHistory?
  reviews           Review[] // salon + hoca ayrı satır (targetType) → çoğul
  activityLog       ActivityLog?

  @@index([userId])
  @@index([sessionId])
  @@index([dropInSlotId])
  @@index([status])
}

model CommissionHistory {
  id               Int      @id @default(autoincrement())
  booking          Booking  @relation(fields: [bookingId], references: [id])
  bookingId        Int      @unique
  userId           Int
  venueId          Int
  instructorId     Int?
  bookingIndex     Int
  commissionRate   Float
  commissionAmount Float
  payer            String
  createdAt        DateTime @default(now())
}

model Payment {
  id              Int       @id @default(autoincrement())
  booking         Booking   @relation(fields: [bookingId], references: [id])
  bookingId       Int       @unique
  userId          Int
  amount          Float
  currency        String    @default("TRY")
  status          String    @default("pending")
  iyzicoPaymentId String?
  iyzicoResponse  Json?
  refundAmount    Float?
  refundedAt      DateTime?
  createdAt       DateTime  @default(now())

  dropInParticipants DropInParticipant[]
}

model VenuePayout {
  id               Int       @id @default(autoincrement())
  venue            Venue     @relation(fields: [venueId], references: [id])
  venueId          Int
  bookingId        Int
  amount           Float
  status           String    @default("pending")
  iyzicoTransferId String?
  transferredAt    DateTime?
  createdAt        DateTime  @default(now())
}

// ─────────────────────────────────────────────
// DEĞERLENDİRME
// ─────────────────────────────────────────────

model Review {
  id              Int         @id @default(autoincrement())
  // Yorum booking'DEN AYRIŞTIRILDI: booking/seans silinse bile yorum kalıcı (salon kötü
  // yorumu seansı silerek temizleyemesin). bookingId nullable → seans silinince null'a çekilir.
  booking         Booking?    @relation(fields: [bookingId], references: [id])
  bookingId       Int?
  reviewer        User        @relation(fields: [reviewerUserId], references: [id])
  reviewerUserId  Int
  targetType      String // 'venue' | 'instructor' — her katılımdan iki satır (salon + hoca)
  venue           Venue?      @relation(fields: [venueId], references: [id])
  venueId         Int?
  instructor      Instructor? @relation(fields: [instructorId], references: [id])
  instructorId    Int?
  classId         Int? // ders-bazlı puan için saklanır (v1'de gösterilmez, ileride kullanılacak)
  rating          Int
  comment         String?
  isAnonymous     Boolean     @default(true)
  venueReply      String? // hedef sahibinin (salon veya hoca) cevabı
  venueRepliedAt  DateTime?
  replyVisibility String? // 'public' (herkes görür) | 'private' (yalnız yorumu yazan + platform)
  createdAt       DateTime    @default(now())

  // (bookingId, targetType) tekil: bir booking için salon+hoca ayrı satır, çift-puan engellenir.
  // bookingId null'ken Postgres NULL'ları farklı sayar → ayrıştırılmış yorumlar çakışmaz.
  @@unique([bookingId, targetType])
  @@index([venueId])
  @@index([instructorId])
  @@index([classId])
  // ban/hesap-silme moderasyon supurmeleri reviewerUserId ile filtreliyor
  @@index([reviewerUserId])
}

// ─────────────────────────────────────────────
// SOSYAL
// ─────────────────────────────────────────────

model Follow {
  id          Int      @id @default(autoincrement())
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  followerId  Int
  following   User     @relation("Following", fields: [followingId], references: [id])
  followingId Int
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  // her profil goruntulemesinde takipci sayimi/listesi followingId ile filtreliyor
  @@index([followingId, status])
}

model ActivityLog {
  id              Int           @id @default(autoincrement())
  user            User          @relation(fields: [userId], references: [id])
  userId          Int
  activityType    String
  booking         Booking?      @relation(fields: [bookingId], references: [id])
  bookingId       Int?          @unique
  dropInSlotId    Int?
  badge           Badge?        @relation(fields: [badgeId], references: [id])
  badgeId         Int?
  tier            Tier?         @relation(fields: [tierId], references: [id])
  tierId          Int?
  sportCategory   SportCategory @relation(fields: [sportCategoryId], references: [id])
  sportCategoryId Int
  venueId         Int?
  description     String
  isVisible       Boolean       @default(true)
  createdAt       DateTime      @default(now())
}

model ActivityLike {
  id        Int      @id @default(autoincrement())
  feedKey   String // e.g. "b-123" (booking) or "d-45" (dropin)
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())

  @@unique([feedKey, userId])
}

model ActivityComment {
  id        Int               @id @default(autoincrement())
  feedKey   String // e.g. "b-123" (booking) or "d-45" (dropin)
  user      User              @relation(fields: [userId], references: [id])
  userId    Int
  content   String
  parent    ActivityComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  parentId  Int?
  replies   ActivityComment[] @relation("CommentReplies")
  createdAt DateTime          @default(now())

  @@index([feedKey, createdAt])
  @@index([userId])
}

model Notification {
  id            Int      @id @default(autoincrement())
  user          User     @relation("NotificationRecipient", fields: [userId], references: [id])
  userId        Int
  type          String // "group_invite" | "like" | "comment" | "follow" | ...
  // message = OLUŞTURMA ANINDA üretilmiş düz metin. Artık yalnız GERİYE DÖNÜK FALLBACK:
  // eski satırlarda (ve messageKey'i olmayan her satırda) istemci bunu gösterir.
  message       String
  // ÇOKLU DİL: yeni bildirimler metin yerine anahtar+parametre saklar → istemci kendi diliyle
  // render eder, kullanıcı dili değiştirince GEÇMİŞ bildirimler de çevrilir. (notifyText.ts katalog)
  messageKey    String?
  messageParams Json?
  relatedUserId Int?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────
// LIDERBOARD & REWARD
// ─────────────────────────────────────────────

model MonthlyLeaderboard {
  id              Int            @id @default(autoincrement())
  user            User           @relation(fields: [userId], references: [id])
  userId          Int
  sportCategory   SportCategory? @relation(fields: [sportCategoryId], references: [id])
  sportCategoryId Int?
  scope           String
  city            City?          @relation(fields: [cityId], references: [id])
  cityId          Int?
  neighborhood    Neighborhood?  @relation(fields: [neighborhoodId], references: [id])
  neighborhoodId  Int?
  year            Int
  month           Int
  lessonCount     Int            @default(0)
  rank            Int?
  updatedAt       DateTime       @updatedAt
}

model RewardPoint {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  points    Int
  source    String
  bookingId Int?
  createdAt DateTime @default(now())

  // Tabloda HİÇ index yoktu. Kritik olan birincisi: check-in'deki idempotans kontrolü
  // (`findFirst({ bookingId, source:'attendance' })`) AÇIK BİR TRANSACTION ve User satır
  // kilidi altında çalışıyor → tam tablo taraması kilidi tuttuğu süreyi tablo büyüdükçe
  // uzatıyordu. İkincisi kullanıcının puan defteri/toplamı sorguları için.
  @@index([bookingId, source])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model VenuePasswordResetToken {
  id        Int      @id @default(autoincrement())
  venueId   Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  venue     Venue    @relation(fields: [venueId], references: [id])
}

model RewardRedemption {
  id             Int      @id @default(autoincrement())
  user           User     @relation(fields: [userId], references: [id])
  userId         Int
  pointsUsed     Int
  discountAmount Float
  bookingId      Int
  createdAt      DateTime @default(now())
}

model FavoriteVenue {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  venue     Venue    @relation(fields: [venueId], references: [id])
  venueId   Int
  createdAt DateTime @default(now())

  @@unique([userId, venueId])
}

model Waitlist {
  id         Int           @id @default(autoincrement())
  user       User          @relation(fields: [userId], references: [id])
  userId     Int
  session    Class_Session @relation(fields: [sessionId], references: [id])
  sessionId  Int
  status     String        @default("waiting") // waiting, notified, expired
  notifiedAt DateTime?
  createdAt  DateTime      @default(now())

  @@unique([userId, sessionId])
  // notifyFirstWaitlistUser + sayaclar sessionId ile filtreliyor
  @@index([sessionId, status, createdAt])
}

model Coupon {
  id            Int       @id @default(autoincrement())
  venue         Venue     @relation(fields: [venueId], references: [id])
  venueId       Int
  code          String    @unique
  discountType  String // "percent" | "fixed"
  discountValue Float
  maxUses       Int?
  perUserLimit  Int? // kişi başı kullanım limiti (null = sınırsız); createBooking'de uygulanır
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  bookings      Booking[]
}

model Referral {
  id                   Int       @id @default(autoincrement())
  referrer             User      @relation("ReferralSender", fields: [referrerId], references: [id])
  referrerId           Int
  referred             User      @relation("ReferralReceiver", fields: [referredId], references: [id])
  referredId           Int
  status               String    @default("pending") // pending | completed
  creditAmount         Int       @default(100) // REFERRAL_POINTS ile senkron (referralController.ts)
  referredBonusGranted Boolean   @default(false) // davet edilene kayıt bonusu (email doğrulama sonrası) verildi mi
  createdAt            DateTime  @default(now())
  completedAt          DateTime?

  @@unique([referrerId, referredId])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Uzun ömürlü yenileme jetonu — access token (kısa ömür) süresi dolunca
// sessizce yenisini almak için. Kullanıcı hiç "tekrar giriş yap" görmez.
// SALON/EĞİTMEN yenileme jetonu. Kullanıcı realm'inde RefreshToken vardı ama panel
// realm'lerinde YOKTU: bu yüzden salon/eğitmen access token'ı 7 GÜN yaşıyordu (kısaltmak
// saat başı çıkış demek olurdu). Salon paneli IBAN/vergi no/TCKN/KYC ve gelir raporu
// taşıdığı için çalınan bir token'ın 7 gün geçerli kalması en büyük açıklardan biriydi.
// Tek tabloda iki realm: FK'lardan tam biri dolu olur.
model PanelRefreshToken {
  id           Int         @id @default(autoincrement())
  token        String      @unique
  venue        Venue?      @relation(fields: [venueId], references: [id])
  venueId      Int?
  instructor   Instructor? @relation(fields: [instructorId], references: [id])
  instructorId Int?
  expiresAt    DateTime
  revoked      Boolean     @default(false)
  // Döndürme (rotation) izi: jeton yenileme sırasında iptal edildiyse dolu, çıkış/parola
  // değişimiyle iptal edildiyse boş kalır. İkisini ayırmak REPLAY tespitinin temelidir.
  rotatedAt    DateTime?
  // OTURUM ZİNCİRİ (family): girişte üretilir, her döndürmede DEVRALINIR. Bir cihazın oturumu
  // = bir aile. Çıkış ve replay tespiti aileyi kapatır — kullanıcının DİĞER cihazları etkilenmez.
  family       String      @default(uuid())
  createdAt    DateTime    @default(now())

  @@index([venueId])
  @@index([instructorId])
  @@index([rotatedAt])
  @@index([family])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  user      User      @relation(fields: [userId], references: [id])
  userId    Int
  expiresAt DateTime
  revoked   Boolean   @default(false)
  rotatedAt DateTime? // bkz. PanelRefreshToken.rotatedAt — replay tespiti
  family    String    @default(uuid()) // bkz. PanelRefreshToken.family — oturum zinciri
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([rotatedAt])
  @@index([family])
}

/// AÇIK RIZA / SÖZLEŞME ONAY KAYDI
///
/// NEDEN VAR: KVKK'da rızanın varlığını İSPAT YÜKÜ veri sorumlusundadır (m.3/1-a, m.5/1).
/// Kayıt ekranlarında onay kutusu göstermek yeterli değil; kimin, ne zaman, HANGİ SÜRÜMÜ
/// onayladığı saklanmalı. Metnin o günkü içeriği repodan geri getirilebilir
/// (fitpass-web/src/lib/hukuk/belgeler.generated.ts commit'lidir), bu yüzden slug+sürüm yeterli.
///
/// User/Venue/Instructor'a FK VERİLMEDİ: üç ayrı özne tipi var ve Prisma'da tek kolondan
/// üç tabloya FK verilemez. Hesap silinince kaydın kalması ZATEN İSTENEN davranıştır —
/// rızanın verildiği anı ispatlayan kayıt, rızayı veren hesaptan bağımsız olarak yaşamalı
/// (kimlikle bağı subjectId'dir; hesap silinince o id'ye karşılık gelen kişi kalmaz).
model ConsentRecord {
  id            Int       @id @default(autoincrement())
  subjectType   String // 'user' | 'venue' | 'instructor'
  subjectId     Int
  docSlug       String // 'gizlilik', 'uyelik', 'acik-riza-ticari-ileti' …
  docVersion    String // SUNUCUNUN bildiği sürüm — istemciye güvenilmez
  /// İstemcinin gösterdiğini İDDİA ettiği sürüm. docVersion'dan farklıysa kullanıcı
  /// bayat bir arayüzde başka bir metin görmüş demektir; sessiz kalmasın diye ayrı tutulur.
  clientVersion String?
  kind          String // 'sozlesme' (üyeliğin önkoşulu) | 'acik_riza' (isteğe bağlı)
  granted       Boolean   @default(true)
  consentedAt   DateTime  @default(now())
  /// İspat için — IP ve cihaz bilgisi Gizlilik Politikası'nda beyan edilmiştir.
  ipAddress     String?
  userAgent     String?
  /// Açık rıza geri alınabilir ve geri alma İLERİYE ETKİLİDİR: satır silinmez, damgalanır.
  revokedAt     DateTime?

  @@index([subjectType, subjectId])
  @@index([docSlug])
}

/// FİNANSAL KAYIT ARŞİVİ — anonimleştirilmiş, yasal saklama için.
///
/// NEDEN VAR: Gizlilik Politikası 11.3, "vergi ve ticaret mevzuatı gereği tutulması zorunlu
/// işlem ve fatura kayıtları ... kimliğinizle bağlantısı koparılarak (anonimleştirilerek)
/// yalnızca ilgili yasal süre boyunca saklanır" diyor. Oysa kod, hesap silmede ve salon
/// ders/seans silmede bu kayıtları HARD DELETE ediyordu: geriye iade borcunu ya da tahsil
/// edilmiş bedeli gösteren hiçbir şey kalmıyordu. Yani metin bir şey vaat ediyor, kod tersini
/// yapıyordu.
///
/// GERÇEKTEN ANONİM: userId YOK, ad/e-posta YOK, User'a FK YOK. Kişiyi değil İŞLEMİ tanımlar.
/// venueId/instructorId satıcıyı gösterir — satıcı kaydı vergi mevzuatının zaten istediği şeydir
/// ve silinen üyeyle ilgisi yoktur.
///
/// SÜRESİZ DEĞİL: purgeAfter (TTK m.82 → 10 yıl) dolduğunda satır imha edilir. Metin "süre
/// sonunda imha edilir" diyor; süresiz saklamak da vaadin ihlali olurdu.
model FinansalKayit {
  id               Int      @id @default(autoincrement())
  bookingNumber    String
  occurredAt       DateTime
  baseAmount       Float
  commissionAmount Float
  userCommission   Float
  venueCommission  Float
  finalAmount      Float
  venuePayout      Float
  groupSize        Int
  venueId          Int?
  instructorId     Int?
  /// Gerçekten tahsilat oldu mu (Payment satırı varsa durumu). Ödeme açılmadan önceki
  /// kayıtlarda null — arşiv, para hareketi olmayan işlemi olmuş gibi göstermemeli.
  paymentStatus    String?
  refundType       String?
  refundAmount     Float?
  /// 'hesap_silindi' | 'seans_silindi'
  reason           String
  archivedAt       DateTime @default(now())
  purgeAfter       DateTime

  @@index([purgeAfter])
  @@index([venueId])
}

/// 5651 TRAFİK KAYDI — yer sağlayıcı yükümlülüğü.
///
/// Gizlilik Politikası Bölüm 7: "5651 sayılı Kanun ve ilgili mevzuat uyarınca yer sağlayıcı
/// sıfatıyla tutulan trafik kayıtları, Kanun'da öngörülen süre (bir yıldan az, iki yıldan fazla
/// olmamak üzere) boyunca saklanır ve süre sonunda imha edilir."
/// Metin bunu beyan ediyordu ama şemada IP tutan TEK BİR KOLON yoktu.
///
/// KAPSAM — her HTTP isteği DEĞİL: yer sağlayıcı trafik bilgisi, yayımlanan içeriği kimin ne
/// zaman nereden yayımladığını gösteren kayıttır. Her istek loglansaydı hem devasa hem de
/// veri asgariliğine aykırı olurdu; hiçbiri loglanmazsa yükümlülük karşılanmaz. Kaydedilen:
/// içerik yayımlama (yorum, akış yorumu, şikâyet) + kimlik olayları (kayıt, giriş).
///
/// ActivityLog BU DEĞİLDİR: o bir sosyal akış tablosudur, IP tutmaz ve kullanıcı silinince gider.
model TrafikKaydi {
  id          Int      @id @default(autoincrement())
  /// 'icerik_yayin' | 'kayit' | 'giris'
  eventType   String
  /// 'user' | 'venue' | 'instructor'. Hesap silinince subjectId NULL'lanır (anonimleştirme):
  /// satır KALIR — Gizlilik 11.3 "trafik kayıtları silinmez, kimlik bağlantısı koparılır" diyor.
  subjectType String?
  subjectId   Int?
  /// Yayımlanan içeriğin türü ve kimliği ('review', 'activity_comment', 'complaint'…)
  contentType String?
  contentId   Int?
  ipAddress   String?
  userAgent   String?
  occurredAt  DateTime @default(now())
  /// Süre sonunda imha — metin "süre sonunda imha edilir" diyor, süresiz saklamak ihlaldir.
  purgeAfter  DateTime

  @@index([purgeAfter])
  @@index([subjectType, subjectId])
  @@index([contentType, contentId])
}

/// SALON HAREKET GÜNLÜĞÜ — satıcının NE YAPTIĞININ kaydı.
///
/// NEDEN VAR: platform bugün yalnızca SON DURUMU biliyordu. Salon bir seansı iptal ettiğinde,
/// saatini değiştirdiğinde, dersi kapattığında ya da fiyatı rezervasyonlardan sonra
/// yükselttiğinde geriye HİÇBİR İZ kalmıyordu (venueController'da tek bir log çağrısı yoktu).
/// "Bu salon sürekli son anda mı iptal ediyor?" sorusu hiçbir veriden cevaplanamıyordu ve
/// bu veri GERİ GETİRİLEMEZ — yazılmadığı her gün kalıcı olarak kaybediliyor.
///
/// ActivityLog BU DEĞİLDİR: o kullanıcının sosyal akışı, satıcı davranışını tutmaz.
///
/// Salon'a FK VERİLMEDİ: salon silinse de davranış kaydı kalmalı — kaydın varlık sebebi
/// tam olarak "sonradan bakabilmek". Silinen salonun geçmişi de sorulabilir olmalı.
model VenueOlay {
  id        Int      @id @default(autoincrement())
  venueId   Int
  /// Olayı yapan: 'venue' (salon paneli) | 'admin' | 'system'
  aktor     String   @default("venue")
  /// 'seans_iptal' | 'seans_guncelle' | 'ders_kapat' | 'ders_guncelle'
  olay      String
  hedefTur  String? // 'session' | 'class'
  hedefId   Int?
  /// Değişimin ÖNCESİ ve SONRASI — yalnız anlamlı alanlar (saat, fiyat, kapasite, aktiflik).
  /// Tüm nesneyi yazmıyoruz: günlük şişer ve kişisel veri sızdırabilir.
  oncesi    Json?
  sonrasi   Json?
  /// Olay anında etkilenen ONAYLI/BEKLEYEN rezervasyon sayısı. Sonradan hesaplanamaz
  /// (rezervasyonlar silinmiş olabilir) — "kaç kişiyi etkiledi" ancak o an yazılırsa bilinir.
  etkilenen Int      @default(0)
  /// Seansa kalan saat. "Son anda iptal" ancak bu yazılırsa ölçülebilir.
  kalanSaat Float?
  olusturma DateTime @default(now())

  @@index([venueId, olusturma])
  @@index([olay])
  @@index([olusturma])
}
